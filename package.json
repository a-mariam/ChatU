    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.1.13",
    "jest": "^29.7.0",
    "jest-expo": "^54.0.11",
    "prettier-plugin-tailwindcss": "^0.5.11",
    "react-test-renderer": "^19.1.0",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3"
  },
  "private": true
